# ---- Interactive Storybook API — production environment ----
# Copy this to `.env` in this directory and fill it in. `deploy.sh` will create
# `.env` for you (with generated secrets) on first run if it's missing.
#
# NEVER commit the real `.env`. It is git-ignored.

# Public hostname the app will call. MUST have a DNS A record pointing at this VPS.
DOMAIN=api.example.com

# Email for Let's Encrypt / ACME (certificate expiry notices).
ACME_EMAIL=you@example.com

# High-entropy secrets — generate each with:  openssl rand -hex 32
# deploy.sh REJECTS the known dev defaults and the CHANGE_ME placeholder.
JWT_SECRET=CHANGE_ME
ASSET_URL_SECRET=CHANGE_ME

# Postgres password (also generate with openssl rand -hex 32).
# Must be URL-safe — it is spliced raw into the DATABASE_URL DSN. Stick to the
# openssl hex output; avoid @ : / # % which break the connection string.
POSTGRES_PASSWORD=CHANGE_ME

# Signed-URL lifetime in seconds (optional; defaults to 3600).
ASSET_URL_TTL_SECONDS=3600

# ---- OpenAI text-to-speech (POST /v1/tts) ----
# REQUIRED — there is no usable default. Without it the TTS endpoint returns 502
# on every request and scan-any-page narrates nothing, while /health and every
# other route stay green, so the failure is invisible until you scan on a device.
# Use a restricted project key: allow Request only for /v1/audio/speech.
# deploy.sh REJECTS the CHANGE_ME placeholder.
OPENAI_API_KEY=CHANGE_ME

# Optional overrides. These defaults match app/config.py, so you can omit them.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_TIMEOUT_SECONDS=30
