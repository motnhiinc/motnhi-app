DATABASE_URL=postgresql+psycopg://storybook:storybook@localhost:5432/storybook
TEST_DATABASE_URL=postgresql+psycopg://storybook:storybook@localhost:5432/storybook_test
# REQUIRED: replace with a real high-entropy secret (e.g. openssl rand -hex 32) before deploying to production
JWT_SECRET=dev-only-not-for-prod-0123456789abcdef0123456789abcdef
# Asset serving (slice 3). Secret must be >=32 bytes in any real environment.
ASSET_URL_SECRET=dev-asset-secret-0123456789abcdef0123456789abcdef
ASSET_URL_TTL_SECONDS=3600
STORAGE_DIR=storage
# OpenAI for speech; legacy clients also use chat/completions for validation.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_TIMEOUT_SECONDS=30
# Per-page parallelism and shared capacity within each server process.
PAGE_AUDIO_CONCURRENCY=6
PAGE_AUDIO_PROCESS_CONCURRENCY=6
OPENAI_PAGE_VALIDATION_MODEL=gpt-4o-mini
OPENAI_PAGE_VALIDATION_TIMEOUT_SECONDS=30
# Enable Cloud Vision API + billing; restrict this server-side key to Vision API.
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_TIMEOUT_SECONDS=15
# TEMPORARY diagnostics: logs page text; disable after debugging.
SCAN_OCR_DEBUG_LOGGING=true
